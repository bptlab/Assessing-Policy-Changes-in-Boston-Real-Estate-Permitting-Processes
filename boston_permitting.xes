		<string key="neighborhood" value="Leather District" />
		<string key="address" value="105 Beach Street" />
		<int key="land_sqft" value="2597" />
		<int key="gross_floor_area_sqft" value="10080" />
		<string key="description" value="The proposed project involves the adaptive reuse of the existing 5-story commercial building located at 105 Beach Street in Boston’s historic Leather District. Currently owned and occupied by Language Studies International (LSI), the building’s upper floors (Floors 2–5, totaling 11,334 GFA) will be converted into 15 residential rental apartments. The ground-floor commercial space will retain its long-standing retail tenant, Figaro’s sandwich shop, while repurposing unused ground-floor area into a residential lobby and additional commercial space. The basement level will accommodate secure indoor bicycle storage and mechanical utilities." />
		<string key="phase" value="Under Review" />
		<string key="project_type" value="Small Project" />
