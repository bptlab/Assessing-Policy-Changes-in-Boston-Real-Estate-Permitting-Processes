		<string key="address" value="140 Providence Street" />
		<int key="land_sqft" value="45439" />
		<int key="gross_floor_area_sqft" value="542000" />
		<string key="description" value="The proposed project would convert the upper floors of the existing building to multifamily residential use, with a total of approximately 476 dwelling units in approximately 501,000 s.f. of GFA, including amenity space newly created in the existing basement. Together, the ground floor and basement would include approximately 41,000 s.f. of retail and restaurant space to activate the Arlington Street, St. James Avenue, and Berkeley Street frontages and reinforce the pedestrian-oriented character of Park Square. Loading from Providence Street would continue, but there are no parking spaces on site and none is proposed." />
		<string key="phase" value="Under Review" />
		<string key="project_type" value="Large Project" />
