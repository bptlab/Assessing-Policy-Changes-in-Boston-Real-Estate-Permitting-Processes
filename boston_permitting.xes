	<trace>
		<string key="concept:name" value="5010" />
		<int key="project_id" value="5010" />
		<string key="name" value="500 Gallivan Boulevard" />
		<string key="url" value="https://www.bostonplans.org/projects/development-projects/500-gallivan-boulevard" />
		<boolean key="in_article_80" value="true" />
		<string key="neighborhood" value="Dorchester" />
		<string key="address" value="500 Gallivan Boulevard" />
		<int key="land_sqft" value="10591" />
		<int key="gross_floor_area_sqft" value="29130" />
		<string key="description" value="The proposed project consists of new construction of a mixed-use building located at 500 Gallivan Boulevard in the Dorchester neighborhood of Boston. The site is currently occupied by a two-story structure formerly used as the Dorchester American Legion Post, which will be demolished to allow for redevelopment of the parcel. The project is intended to reinvest in an underutilized site along an established neighborhood corridor and contribute new residential and commercial activity consistent with the surrounding urban context. The proposed building will be five stories in height and will include ground-level commercial space with residential dwelling units located on the upper floors. A total of 24 residential units are proposed as part of the development, contributing to the City’s housing supply and supporting a mix of uses along Gallivan Boulevard. The design of the building and site will be evaluated through the Article 80 review process to ensure appropriate massing, access, and integration with adjacent uses and the public realm.  The building will have a total gross floor area of approximately 36,055 square feet and a maximum building height of approximately 58.5 feet. The project will provide 10 off-street parking spaces, along with associated access and site improvements, to support the proposed uses" />
		<string key="phase" value="Under Review" />
		<string key="project_type" value="Small Project" />
