			<string key="text" value="&lt;table class='socialEventTable' &gt;&lt;tr&gt;&lt;td&gt;Event:&lt;/td&gt;&lt;td&gt;40 Mount Hood Road Impact Advisory Group Meeting&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Location:&lt;/td&gt;&lt;td&gt;Hotel Boston&lt;br /&gt;&#13;&#10;1650 Commonwealth Avenue&lt;br /&gt;&#13;&#10;Boston, MA 02135&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt; &lt;td&gt;Time:&lt;/td&gt;&lt;td&gt;5:30 PM - 6:30 PM&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" />
