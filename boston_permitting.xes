	<trace>
		<string key="concept:name" value="2735" />
		<int key="project_id" value="2735" />
		<string key="name" value="201 Stuart Street-Motor Mart Garage" />
		<string key="url" value="https://www.bostonplans.org/projects/development-projects/motor-mart-garage" />
		<boolean key="in_article_80" value="true" />
		<string key="neighborhood" value="Downtown" />
		<string key="address" value="201 Stuart Street" />
		<int key="land_sqft" value="52323" />
		<int key="gross_floor_area_sqft" value="731000" />
		<string key="description" value="201 Stuart Street Owner, LLC (the Proponent), an affiliate of CIM Group LLC, together with its development partner Boston Global Investors, LLC, proposes to redevelop the existing eight-story, Motor Mart Garage into a vibrant, mixed-use building by adding basement level retail space, reducing parking, and constructing new residential apartments within the western portion of the existing building, and constructing new residential apartments and condominiums within a 20-story residential tower rising out of the existing building (the Project). The Project will create a mix of approximately 231 new condominium units, retain approximately 46,000 sf of retail and restaurant space, and retain 672 parking spaces." />
		<string key="phase" value="Board Approved" />
