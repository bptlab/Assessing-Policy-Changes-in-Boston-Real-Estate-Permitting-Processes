		<string key="address" value="80-100 Smith Street" />
		<int key="land_sqft" value="62986" />
		<int key="gross_floor_area_sqft" value="243212" />
		<string key="description" value="The 2022 NPC Project will replace the existing buildings at 80 and 100 Smith Street with new residential buildings having approximately 202,000 sf of new gross floor area and approximately 218 rental units. The NPC Project will include approximately 19,270 sf of open space to serve the Project’s residents. Vehicular parking and service access and loading will be accessed via a modified curb cut on St. Alphonsus Street, with approximately 19 parking spaces in an open-air surface lot at grade, and 68 parking spaces in a below-grade garage. Ground level storage will be provided for a total of approximately 262 bicycles, including 218 secured long-term bike parking spaces and 44 short-term exterior spaces around the site. 90 Smith Street, renovated in 2010, consists of approximately 40,000 square feet of office space." />
		<string key="phase" value="Board Approved" />
		<string key="project_type" value="Large Project" />
