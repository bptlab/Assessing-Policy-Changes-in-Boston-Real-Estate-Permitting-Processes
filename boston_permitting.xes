	<trace>
		<string key="concept:name" value="1698" />
		<int key="project_id" value="1698" />
		<string key="name" value="104 Canal Street Hotel Development" />
		<string key="url" value="https://www.bostonplans.org/projects/development-projects/104-canal-street" />
		<boolean key="in_article_80" value="true" />
		<string key="neighborhood" value="West End" />
		<string key="address" value="104 Canal Street" />
		<int key="land_sqft" value="3598" />
		<int key="gross_floor_area_sqft" value="47355" />
		<string key="description" value="The original proposed project consists of 15 above grade stories to be utilized as a 90 guestroom overnight-stay hotel facility, designed to have a ground floor lobby, café and amenity space opening directly onto Canal Street. The proposed Small Project Change is an increase in the expected number of guestrooms from 90 to 98, removal of the originally proposed café, which is replaced by a smaller café for the guests, and refinements to the facades made in consultation with BPDA Urban Design staff." />
		<string key="phase" value="Board Approved" />
		<string key="project_type" value="Small Project" />
