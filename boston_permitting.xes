		<boolean key="in_article_80" value="true" />
		<string key="neighborhood" value="Chinatown" />
		<string key="address" value="290 Tremont Street" />
		<int key="land_sqft" value="29153" />
		<int key="gross_floor_area_sqft" value="130000" />
		<string key="description" value="The Project consists of the construction of a new twelve-story, mixed-income residential development of approximately 127,000 square feet of Gross Floor Area (as calculated pursuant to the code, “GFA”) of income-restricted rental housing and approximately 3,000 square feet of GFA of ground floor space dedicated to a community/commercial use (“Project”). The Project will advance the City’s 2030 Housing Plan's housing creation goals and introduce “development without displacement” in a neighborhood with limited development opportunities.&#10;&#10;When completed, the Project will significantly enhance the stock of income-restricted rental and homeownership housing available in the Chinatown neighborhood. The Project will include approximately one hundred eleven (111) rental apartments restricted to income-eligible renters." />
		<string key="phase" value="Board Approved" />
		<string key="project_type" value="Large Project" />
