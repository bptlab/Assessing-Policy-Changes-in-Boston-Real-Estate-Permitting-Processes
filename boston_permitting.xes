	<trace>
		<string key="concept:name" value="4722" />
		<int key="project_id" value="4722" />
		<string key="name" value="On the Square" />
		<string key="url" value="https://www.bostonplans.org/projects/development-projects/on-the-square-(587-595-washington-st)" />
		<boolean key="in_article_80" value="true" />
		<string key="neighborhood" value="Dorchester" />
		<string key="address" value="587-591-595 Washington Street" />
		<int key="land_sqft" value="0" />
		<int key="gross_floor_area_sqft" value="0" />
		<string key="description" value="OTS is a new development project that will transform approximately 10,000 square feet of existing retail office building into a new mixed-use building in Codman Square. The project will demolish the existing building and garage in an adjacent lot to construct a new five-story mixed use commercial/residential containing 73,472 square feet of office/residential space. The commercial/retail space will bring back some existing tenants of the current building and will potentially add new retail tenants. The residential portion of the building will include 41 affordable rental units to families with incomes below 60% AMI. There will be 14 one-bedroom units, 23 two bed units and 4 three bed units available for these tenants." />
		<string key="phase" value="Under Review" />
		<string key="project_type" value="Large Project" />
