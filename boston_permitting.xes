		<string key="concept:name" value="3142" />
		<int key="project_id" value="3142" />
		<string key="name" value="Alexandra Hotel" />
		<string key="url" value="https://www.bostonplans.org/projects/development-projects/alexandra-hotel" />
		<boolean key="in_article_80" value="true" />
		<string key="neighborhood" value="Roxbury" />
		<string key="address" value="1767-1769 Washington Street" />
		<int key="land_sqft" value="8025" />
		<int key="gross_floor_area_sqft" value="38780" />
		<string key="description" value="The Alexandra Partners LLC plans to redevelop an 8,025-square-foot site at the intersection of Washington Street and Massachusetts Avenue. The project consists of two parcels, one of which is a vacant lot at 1769 Washington Street. The other parcel at 1767 Washington and 631 Massachusetts Avenue is the location of the historic Hotel Alexandra which was built in 1875. The redevelopment will create a 68-room hotel spanning 38,780 square feet, incorporating the existing 27,200-square-foot structure with an 11,580-square-foot addition. The proposal aims to restore and preserve the hotel's façade and select interior elements." />
		<string key="phase" value="Board Approved" />
		<string key="project_type" value="Small Project" />
