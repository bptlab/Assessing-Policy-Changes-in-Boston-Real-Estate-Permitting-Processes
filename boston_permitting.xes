		<string key="url" value="https://www.bostonplans.org/projects/development-projects/80-west-broadway" />
		<boolean key="in_article_80" value="true" />
		<string key="neighborhood" value="South Boston" />
		<string key="address" value="80-110 West Broadway Way" />
		<int key="land_sqft" value="21770" />
		<int key="gross_floor_area_sqft" value="75500" />
		<string key="description" value="80 West Broadway, LLC (the “Developer”) will preserve the street-facing facades of the existing four-story, brick building, converting the ground floor into a café or smaller bar/restaurant space while demolishing the one-story addition Amrheins uses today, and construct a new building. The remainder of the Site – both the site of the to-be-demolished addition and the 44-car parking lot - will be redeveloped with a new, five-story, approximately 87,000 square-foot, mixed-use building, with general office and product development or prototype manufacturing uses space (and expressly excluding basic laboratory use), and including restaurant / retail / services space totaling approximately 2,900 square feet at the ground floor. The Project will also include approximately 25 below-grade parking spaces (the “Proposed Project”)." />
		<string key="phase" value="Board Approved" />
		<string key="project_type" value="Large Project" />
