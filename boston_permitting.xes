		<boolean key="in_article_80" value="false" />
		<string key="neighborhood" value="Downtown" />
		<string key="address" value="45 Bromfield Street" />
		<int key="land_sqft" value="6069" />
		<int key="gross_floor_area_sqft" value="0" />
		<string key="description" value="The proposed project would be constructed on an approximately 6,069 square foot site at the corner of Bromfield and Province Streets now occupied by four largely vacant and obsolete commercial buildings. The proposed project would be a 155 foot tall, approximately 97,000 gross square feet building containing approximately 3,500 square feet of retail uses on the ground floor, and residential uses on its upper 16 stories. The building will contain approximately 158 rental apartments – approximately 127 market-rate units as well as 31 income-restricted apartments. The ground-floor retail space will be located at the corner of Province and Bromfield Streets, and the building's main lobby will be on Bosworth Street, with a secondary residential entrance on Bromfield Street. The building is not proposed to include any parking facilities." />
		<string key="phase" value="Letter of Intent" />
		<string key="project_type" value="Large Project" />
		<event>
			<string key="concept:name" value="Letter of Intent (LOI)" />
