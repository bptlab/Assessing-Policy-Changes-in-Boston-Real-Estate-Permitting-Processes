	<trace>
		<string key="concept:name" value="3448" />
		<int key="project_id" value="3448" />
		<string key="name" value="St. Elizabeth's Medical Center Parking Garage" />
		<string key="url" value="https://www.bostonplans.org/projects/development-projects/st-elizabeths-medical-center-parking-garage" />
		<boolean key="in_article_80" value="true" />
		<string key="neighborhood" value="Brighton" />
		<string key="address" value="253 Washington Street" />
		<int key="land_sqft" value="42450" />
		<int key="gross_floor_area_sqft" value="201255" />
		<string key="description" value="The Elizabeth's Medical Center Institutional Master Plan (IMP) includes five Proposed Institutional Projects, construction of an approximately 201,255 square-foot parking garage, demolition of Garage A, demolition of the Quinn Building, upgrades to the Center for Biomedical Research Building (“CBR”), and improvements to the Nevins Street entryway to the SEMC campus. Of these, the Parking Garage project is currently undergoing Large Project Review. The DPIR described a proposal to redevelop the Project Site at 253 Washington Street, Brighton into an approximately 201,255 square feet (sf) parking garage, accommodating 610 parking spaces, a 64-space secure bike room, and a rooftop solar array." />
		<string key="phase" value="Board Approved" />
		<string key="project_type" value="Large Project" />
