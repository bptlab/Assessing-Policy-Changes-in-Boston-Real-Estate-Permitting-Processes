	<trace>
		<string key="concept:name" value="3684" />
		<int key="project_id" value="3684" />
		<string key="name" value="176 Lincoln Street" />
		<string key="url" value="https://www.bostonplans.org/projects/development-projects/176-lincoln-street" />
		<boolean key="in_article_80" value="true" />
		<string key="neighborhood" value="Brighton" />
		<string key="address" value="176 Lincoln Street" />
		<int key="land_sqft" value="229982" />
		<int key="gross_floor_area_sqft" value="790000" />
		<string key="description" value="Berkeley Investments (the &quot;Proponent&quot;), through its subsidiary Berkeley 176 Lincoln Holdings, LLC, proposes the redevelopment of the approximately 5.2-acre site at 176 Lincoln Street in the Allston/Brighton neighborhood of Boston. The proposal calls for the demolition of the existing and long-vacant building on site, and details the Proponent's proposal for the creation of a new, three (3)-building, mixed-use project totaling approximately 790,000 total square feet (the &quot;Proposed Project&quot;). The Proposed Project is contemplated to include approximately 551,500 square feet of office and/or research and development space in two (2) primarily commercial buildings, while one (1) primarily residential building is anticipated to include approximately 252 residential units. The ground-floor of each building will be activated on all sides, with approximately 18,000 square feet of retail space included across the Proposed Project. Vehicular parking for the Proposed Project will be available in a shared below-grade parking garage." />
		<string key="phase" value="Board Approved" />
		<string key="project_type" value="Large Project" />
