	<trace>
		<string key="concept:name" value="3308" />
		<int key="project_id" value="3308" />
		<string key="name" value="Gardner Street and Charles Park Road Project" />
		<string key="url" value="https://www.bostonplans.org/projects/development-projects/180-199-gardner-street" />
		<boolean key="in_article_80" value="true" />
		<string key="neighborhood" value="West Roxbury" />
		<string key="address" value="180 - 199 Gardner Street" />
		<int key="land_sqft" value="62402" />
		<int key="gross_floor_area_sqft" value="96104" />
		<string key="description" value='West Brighton Acquisitions, LLC and its Principal, Peter Davos, proposes the revitalization and conversion of approximately 1.4 acres of nondescript industrial and residential property at 17 - 31 Charles Park Road, 180 - 198 Gardner Street, and 199 Gardner Street, and which includes four (4) parcels of land along both sides of Gardner Street (the "Project Site"), into a multi-building, residential development totaling approximately 96,105 square feet of Gross Floor Area.&#10;&#10;The Proposed Project contemplates the construction of eighteen (18) three-bedroom townhouses, each with its own deck area/open space, garage, and driveway parking, and a mid-rise seventy (70)-unit apartment building.106 on-site parking spaces are included in the Proposed Project, including eighteen (18) tandem spaces in the townhouse units.' />
		<string key="phase" value="Construction Complete" />
		<string key="project_type" value="Large Project" />
