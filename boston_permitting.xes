	<trace>
		<string key="concept:name" value="3542" />
		<int key="project_id" value="3542" />
		<string key="name" value="761-793 Boylston Street" />
		<string key="url" value="https://www.bostonplans.org/projects/development-projects/761-793-boylston-street" />
		<boolean key="in_article_80" value="true" />
		<string key="neighborhood" value="Back Bay" />
		<string key="address" value="761-793 Boylston Street" />
		<int key="land_sqft" value="19500" />
		<int key="gross_floor_area_sqft" value="94419" />
		<string key="description" value="The proposed development program provides a mix of uses complimentary to the fabric of the Back Bay. The Project proposes an eight-story mixed use building, building upon the existing three-story building and adding five levels on top of 761-793 Boylston Street.&#10;&#10;The Project proposes approximately 15,830 SF of retail, 25,720 SF of office/fitness and nine residential units within the top three stories totaling approximately 18,600 SF. The retail uses occupies level 1 through level 2, followed by office space on levels 3 through 5, and residential units on levels 6 through 8. A rooftop amenity for the residential units is also imagined. A lobby accessed from an entrance on Boylston Street leads to a compact vertical&#10;elevator and fire stair core located to the northern edge of the floor plan. The core provides access to all upper levels." />
		<string key="phase" value="Construction Complete" />
		<string key="project_type" value="Large Project" />
