		<string key="address" value="15-25 Harrison Avenue" />
		<int key="land_sqft" value="3275" />
		<int key="gross_floor_area_sqft" value="71654" />
		<string key="description" value="The Proponent proposes to redevelop an approximately 3,275-square-foot Project Site (having an assessor’s parcel number of 0304979020), which is currently occupied by a dilapidated and vacant 5-story commercial building, into a new 25-story hotel consisting of approximately 106- guest rooms occupying approximately 79,300 square feet of gross floor area including 600 square feet of community art space at the ground floor. The new hotel building will take advantage of nearby available off-site parking in several public garages. The new hotel will be served by 20 bicycle storage spaces within the building as well as providing 6 exterior bicycle spaces for visitors in conformance with City guidelines." />
		<string key="phase" value="Under Review" />
		<string key="project_type" value="Large Project" />
