		<int key="gross_floor_area_sqft" value="34647" />
		<string key="description" value="The project proposes the construction of a new six (6) story 39 unit residential building of approximately 34,647 square feet of gross floor area, with on-site parking for 14 vehicles, bicycle parking spaces and improvements in landscaping, pedestrian connectivity, and related public realm improvements in and around the Site, consistent with the character and housing needs of the surrounding community (the “Proposed Project”). The project is anticipated to include two (2) studio units, nineteen (19) one-bedroom units, thirteen (13) two-bedroom units, and five (5) three-bedroom units." />
		<string key="phase" value="Board Approved" />
		<string key="project_type" value="Small Project" />
