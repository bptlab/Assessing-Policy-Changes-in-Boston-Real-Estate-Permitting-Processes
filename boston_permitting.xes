	<trace>
		<string key="concept:name" value="4687" />
		<int key="project_id" value="4687" />
		<string key="name" value="262 St. Botolph Street Multipurpose Athletic Facility" />
		<string key="url" value="https://www.bostonplans.org/projects/development-projects/northeastern-university-matthews-arena-project" />
		<boolean key="in_article_80" value="true" />
		<string key="neighborhood" value="Fenway" />
		<string key="address" value="262 St. Botolph Street" />
		<int key="land_sqft" value="97969" />
		<int key="gross_floor_area_sqft" value="310000" />
		<string key="description" value="Northeastern University has submitted a Project Notification Form (PNF) for the redevelopment of the 262 St. Botolph Street site, which currently houses Matthews Arena and a surface parking lot. Northeastern proposes to construct a new 310,000 square foot athletic and event facility on the site. The Proposed Project includes four floors of high bay space that will accommodate arena programming for student recreational, varsity athletics uses and community events and programming. In addition to providing new facilities for varsity basketball and hockey, the Proposed Project will add approximately 54,000 sf of multipurpose recreation and fitness space that will serve as additional passive recreation space for students and function as event space. As the first project within Northeastern’s new Institutional Master Plan (IMP), the Project will enhance the overall campus plan and aesthetically integrate with and complement the surroundings of this unique site while providing for Northeastern’s varsity athletics programs, student recreation programming and community events." />
		<string key="phase" value="Board Approved" />
		<string key="project_type" value="Large Project" />
