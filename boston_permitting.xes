	<trace>
		<string key="concept:name" value="3849" />
		<int key="project_id" value="3849" />
		<string key="name" value="Nubian Square Ascends" />
		<string key="url" value="https://www.bostonplans.org/projects/development-projects/nubian-square-ascends" />
		<boolean key="in_article_80" value="true" />
		<string key="neighborhood" value="Roxbury" />
		<string key="address" value="2164 Washington Street" />
		<int key="land_sqft" value="87879" />
		<int key="gross_floor_area_sqft" value="365475" />
		<string key="description" value="The Nubian Square Ascends Project will transform Nubian Square into a cultural, entertainment, and artistic mecca that celebrates the rich diversity of the neighborhood. This mixed-use project will be developed by an all-minority team. Nubian Square Ascends will offer retail, entertainment, Artist Housing, commercial uses, and a 300-space parking garage.&#10;&#10;The project is anticipated to become a nexus of science, academic, and medical research, given its location in a key institutional corridor.  A comprehensive wealth-creation plan will include approximately 900 permanent jobs and contract opportunities for Minority and Women-Owned Business Enterprises (M/WBE) during all project phases.&#10;&#10;The NPC, filed in July 2023 seeks to update the IDP program for the project to include all residential units in the project." />
		<string key="phase" value="Board Approved" />
		<string key="project_type" value="Large Project" />
