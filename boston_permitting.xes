	<trace>
		<string key="concept:name" value="2730" />
		<int key="project_id" value="2730" />
		<string key="name" value="40 Mount Hood Road" />
		<string key="url" value="https://www.bostonplans.org/projects/development-projects/40-mount-hood-road" />
		<boolean key="in_article_80" value="false" />
		<string key="neighborhood" value="Brighton" />
		<string key="address" value="40 Mount Hood Road" />
		<int key="land_sqft" value="75084" />
		<int key="gross_floor_area_sqft" value="164340" />
		<string key="description" value='* 1650 Commonwealth, LLC (the "Proponent"), has filed a Notice of Project Change Letter to the BPDA.  The change is necessitated by the market realities, in the wake of the COVID-19 pandemic.  The Proponent has extensive experience with residential condominium projects, including on-site, inclusionary affordable housing.  However, the Proponent has been experiencing a fundamental shift in the Greater Boston residential development market.&#10;&#10;&#10;1650 Commonwealth, LLC (the "Proponent"), proposes to develop an approximately 1.7-acre site at 40 Mount Hood Road in the Brighton neighborhood of Boston. The existing site, located at the corner of Mount Hood Road and Egremont Road, currently consists of a motel containing 74 hotel rooms in three separate buildings, as well as surface parking spaces. The site will be developed into an approximately 165,310 square foot residential building containing approximately 151 residential rental units and 204 parking spaces.  &#10;&#10;The Project plans to improve the public realm with approximately 10,000 square feet of landscaped space lining the property on both Mount Hood and Egremont Roads. This will create an active edge along a corridor that connects the residential neighborhood to Commonwealth Avenue, which is well served by public transit.  The pedestrian experience will be further enhanced with new street furniture, trees, plantings, lightning and path patterning.' />
		<string key="project_type" value="Large Project" />
		<event>
			<string key="concept:name" value="Letter of Intent (LOI)" />
			<date key="time:timestamp" value="2017-11-14T00:00:00+00:00" />
