		<string key="name" value="Boston College Conte Forum North Expansion and Renovation" />
		<string key="url" value="https://www.bostonplans.org/projects/development-projects/boston-college-conte-forum-north-expansion-and-ren" />
		<boolean key="in_article_80" value="false" />
		<string key="neighborhood" value="Brighton" />
		<string key="address" value="2601 Beacon Street" />
		<int key="land_sqft" value="2279266" />
		<int key="gross_floor_area_sqft" value="32235" />
		<string key="description" value="The Proposed Project involves the renovation (approx. 22,000 GFA) of a portion of Silvio O. Conte Forum and building an addition (approx. 10,000 GFA) to the northern side of the building with associated site improvements on the Chestnut Hill Campus of Boston College. The interior renovation includes the alteration of exterior walls to increase natural light, a reconfigured layout of Power Gym and a reconfigured band room. The addition will house new men's and women's basketball team locker rooms, a sports medicine suite, strength and conditioning room, nutrition room with food stations and dining, as well as expand the Gate C entry to the concourse and improve the entrance's accessibility. Gabelli Plaza will be enhanced with new plantings, seating areas and pavement." />
		<string key="project_type" value="Small Project" />
