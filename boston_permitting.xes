	<trace>
		<string key="concept:name" value="4858" />
		<int key="project_id" value="4858" />
		<string key="name" value="201 Hampden Street" />
		<string key="url" value="https://www.bostonplans.org/projects/development-projects/201-hampden-street" />
		<boolean key="in_article_80" value="true" />
		<string key="neighborhood" value="Roxbury" />
		<string key="address" value="201 Hampden Street" />
		<int key="land_sqft" value="5213" />
		<int key="gross_floor_area_sqft" value="20194" />
		<string key="description" value="201 Hampden Street was previously approved as a five-story, approximately 20,430-square-foot condominium development containing 13 market-rate residential units under Building Permit ERT 959528. The site has remained vacant and unimproved for more than 30 years.&#10;&#10;In response to evolving housing needs and market conditions, the proposed project seeks to increase the number of residential units while remaining substantially within the previously approved zoning envelope. The revised proposal maintains the approved building height and features a smaller overall building footprint and gross floor area, while introducing a more efficient unit mix and floor plan layout that increases housing production. The project will provide 24 homeownership units, including three Income-Restricted Units, helping to address Boston's housing shortage while delivering a high-performance, transit-oriented residential building adjacent to Dudley Town Common." />
		<string key="phase" value="Under Review" />
		<string key="project_type" value="Small Project" />
