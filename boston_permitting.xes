			<string key="text" value="&lt;span class='sm-obligations'&gt;Community Benefits&lt;/span&gt;&lt;table class='obligationTable' &gt;&lt;tr class='obFirstTr'&gt;&lt;td class='obName'&gt;Affirmative Marketing and Local Preference&lt;/td&gt;&lt;td&gt;&lt;img alt= 'Category: Other' title = 'Other' src='http://www.bostonplans.org/images/placeholders/ComBen_Icons/Other.png'&gt;&lt;/img&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr class='oblastTr'&gt;&lt;td&gt;&lt;span&gt;Amount:&lt;/span&gt;&lt;p&gt;Non-Monetary&lt;/td&gt;&lt;td&gt;&lt;span&gt;Description:&lt;/span&gt;&lt;p&gt;Affirmative Marketing and Local Preference&lt;/p&gt;&lt;/td&gt;&lt;td class='obSeperator'&gt;&amp;nbsp&lt;/td&gt;&lt;/tr&gt;&lt;tr class='obFirstTr'&gt;&lt;td class='obName'&gt;Increased On-Site Affordable Housing Commitment&lt;/td&gt;&lt;td&gt;&lt;img alt= 'Category: IDP' title = 'IDP' src='http://www.bostonplans.org/images/placeholders/ComBen_Icons/IDP.png'&gt;&lt;/img&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr class='oblastTr'&gt;&lt;td&gt;&lt;span&gt;Amount:&lt;/span&gt;&lt;p&gt;Non-Monetary&lt;/td&gt;&lt;td&gt;&lt;span&gt;Description:&lt;/span&gt;&lt;p&gt;Inclusionary Development Policy payment&lt;/p&gt;&lt;/td&gt;&lt;td class='obSeperator'&gt;&amp;nbsp&lt;/td&gt;&lt;/tr&gt;&lt;tr class='obFirstTr'&gt;&lt;td class='obName'&gt;Transit-Oriented and Active Transportation Support&lt;/td&gt;&lt;td&gt;&lt;img alt= 'Category: Transportation Improvements' title = 'Transportation Improvements' src='http://www.bostonplans.org/images/placeholders/ComBen_Icons/Transportation Improvements.png'&gt;&lt;/img&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr class='oblastTr'&gt;&lt;td&gt;&lt;span&gt;Amount:&lt;/span&gt;&lt;p&gt;Non-Monetary&lt;/td&gt;&lt;td&gt;&lt;span&gt;Description:&lt;/span&gt;&lt;p&gt;Transit-Oriented and Active Transportation Support&lt;/p&gt;&lt;/td&gt;&lt;td class='obSeperator'&gt;&amp;nbsp&lt;/td&gt;&lt;/tr&gt;&lt;tr class='obFirstTr'&gt;&lt;td class='obName'&gt;Neighborhood Design Integration&lt;/td&gt;&lt;td&gt;&lt;img alt= 