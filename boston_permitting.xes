		<int key="land_sqft" value="16564" />
		<int key="gross_floor_area_sqft" value="48000" />
		<string key="description" value="The proposed project consists of the redevelopment of a 16,564 square-foot lot at 247 Hancock Street in Dorchester (the “Project”). The Project is a multifamily residential development comprised of a six story building that will contain 47 residential units, approximately 1,500 square feet of public open space, 18 accessory off-street parking spaces and 57 bike storage spaces. The Project will utilize numerous alternative transit options including a building-dedicated on-site electric vehicle share and ample bicycle amenities." />
		<string key="phase" value="Under Construction" />
		<string key="project_type" value="Small Project" />
		<event>
