		<boolean key="in_article_80" value="true" />
		<string key="neighborhood" value="South Boston Waterfront" />
		<string key="address" value="10 Codfish Way" />
		<int key="land_sqft" value="171626" />
		<int key="gross_floor_area_sqft" value="92913" />
		<string key="description" value="Parcel 6 is located in the MassPort Marine Terminal. The original project consisted of three sub-parcels (Parcel 6A, 6B and 6C) for an approximately 220,000 gross square footage development. The project is now concentrated on parcels 6A and 6B for a development of approximately 90,000 gross square feet. Parcel 6A is occupied by Boston Sword &amp; Tuna with a purpose-built fresh seafood processing and distribution plant. Parcel 6B is intended for the construction of a new seafood facility to relocate two seafood businesses (F.J. O'Hara and Pangea Shellfish) from their obsolescent facilities in the Marine Park." />
		<string key="phase" value="Board Approved" />
		<string key="project_type" value="Large Project" />
