			<string key="text" value="&lt;span class='sm-obligations'&gt;Community Benefits&lt;/span&gt;&lt;table class='obligationTable' &gt;&lt;tr class='obFirstTr'&gt;&lt;td class='obName'&gt;Oak Square YMCA Commitment&lt;/td&gt;&lt;td&gt;&lt;img alt= 'Category: Community Based Organizations' title = 'Community Based Organizations' src='http://www.bostonplans.org/images/placeholders/ComBen_Icons/Community Based Organizations.png'&gt;&lt;/img&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr class='oblastTr'&gt;&lt;td&gt;&lt;span&gt;Amount:&lt;/span&gt;&lt;p&gt;$120,000.00&lt;/td&gt;&lt;td&gt;&lt;span&gt;Description:&lt;/span&gt;&lt;p&gt;Oak Square YMCA Commitment&lt;/p&gt;&lt;/td&gt;&lt;td class='obSeperator'&gt;&amp;nbsp&lt;/td&gt;&lt;/tr&gt;&lt;tr class='obFirstTr'&gt;&lt;td class='obName'&gt;ABCD contribution&lt;/td&gt;&lt;td&gt;&lt;img alt= 'Category: Other' title = 'Other' src='http://www.bostonplans.org/images/placeholders/ComBen_Icons/Other.png'&gt;&lt;/img&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr class='oblastTr'&gt;&lt;td&gt;&lt;span&gt;Amount:&lt;/span&gt;&lt;p&gt;$600,000.00&lt;/td&gt;&lt;td&gt;&lt;span&gt;Description:&lt;/span&gt;&lt;p&gt;ABCD contribution&lt;/p&gt;&lt;/td&gt;&lt;td class='obSeperator'&gt;&amp;nbsp&lt;/td&gt;&lt;/tr&gt;&lt;tr class='obFirstTr'&gt;&lt;td class='obName'&gt;BHA Commonwealth Development contribution&lt;/td&gt;&lt;td&gt;&lt;img alt= 'Category: Other' title = 'Other' src='http://www.bostonplans.org/images/placeholders/ComBen_Icons/Other.png'&gt;&lt;/img&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr class='oblastTr'&gt;&lt;td&gt;&lt;span&gt;Amount:&lt;/span&gt;&lt;p&gt;$300,000.00&lt;/td&gt;&lt;td&gt;&lt;span&gt;Description:&lt;/span&gt;&lt;p&gt;BHA Commonwealth Development contribution&lt;/p&gt;&lt;/td&gt;&lt;td class='obSeperator'&gt;&amp;nbsp&lt;/td&gt;&lt;/tr&gt;&lt;tr class='obFirstTr'&gt;&lt;td class='obName'&gt;Allston -Brighton Mobility Study contribution&lt;/td&gt;&lt;td&gt;&lt;img alt= 'Category: Transportation Improvements' title = 'Transportation Improvements' src='http://www.bostonplans.org/images/placeholders/ComBen_Icons/Transportation Improvements.png'&gt;&lt;/img&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr class='oblastTr'&gt;&lt;td&gt;&lt;span&gt;Amount:&lt;/span&gt;&lt;p&gt;$150,000.00&lt;/td&gt;&lt;td&gt;&lt;span&gt;Description:&lt;/span&gt;&lt;p&gt;Allston -Brighton Mobility Study contribution&lt;/p&gt;&lt;/td&gt;&lt;td class='obSeperator'&gt;&amp;nbsp&lt;/td&gt;&lt;/tr&gt;&lt;tr class='obFirstTr'&gt;&lt;td class='obName'&gt;BlueBikes and Transportation Improvements&lt;/td&gt;&lt;td&gt;&lt;img alt= 'Category: Transportation Improvements' title = 'Transportation Improvements' src='http://www.bostonplans.org/images/placeholders/ComBen_Icons/Transportation Improvements.png'&gt;&lt;/img&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr class='oblastTr'&gt;&lt;td&gt;&lt;span&gt;Amount:&lt;/span&gt;&lt;p&gt;$150,000.00&lt;/td&gt;&lt;td&gt;&lt;span&gt;Description:&lt;/span&gt;&lt;p&gt;BlueBikes and Transportation Improvements&lt;/p&gt;&lt;/td&gt;&lt;td class='obSeperator'&gt;&amp;nbsp&lt;/td&gt;&lt;/tr&gt;&lt;tr class='obFirstTr obHidden'&gt;&lt;td class='obName'&gt;TAPA&lt;/td&gt;&lt;td&gt;&lt;img alt= 'Category: Transportation Improvements' title = 'Transportation Improvements' src='http://www.bostonplans.org/images/placeholders/ComBen_Icons/Transportation Improvements.png'&gt;&lt;/img&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr class='oblastTr obHidden'&gt;&lt;td&gt;&lt;span&gt;Amount:&lt;/span&gt;&lt;p&gt;Non-Monetary&lt;/td&gt;&lt;td&gt;&lt;span&gt;Description:&lt;/span&gt;&lt;p&gt;TAPA&lt;/p&gt;&lt;/td&gt;&lt;td class='obSeperator'&gt;&amp;nbsp&lt;/td&gt;&lt;/tr&gt;&lt;tr class='showMoreTr'&gt;&lt;td&gt;&lt;a id='obToggleButton' onclick='javascript:obShowToggle();'&gt;Show More &lt;/a&gt;&lt;/td&gt;&lt;/tr&gt; &lt;/table&gt;" />
