		<boolean key="in_article_80" value="true" />
		<string key="neighborhood" value="Hyde Park" />
		<string key="address" value="15 Everett Street" />
		<int key="land_sqft" value="73586" />
		<int key="gross_floor_area_sqft" value="93156" />
		<string key="description" value='The William Barton Rogers School Project ("the Project") involves the adaptive re-use of the historic school building into a residential mixed-income rental development with approximately 74 housing units, all of which will be affordable to households earning up to 100% of Area Median Income (“AMI”)” All residential units will be age-restricted housing for teh 62+ population. In addition, the Project will include approximately 5 surface parking spaces, and will be constructed to high sustainability and energy efficiency standards with a proposed target - if feasible - of LEED Gold certifiability.' />
		<string key="phase" value="Construction Complete" />
		<string key="project_type" value="Large Project" />
