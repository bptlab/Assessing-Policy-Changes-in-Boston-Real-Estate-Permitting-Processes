	<trace>
		<string key="concept:name" value="4024" />
		<int key="project_id" value="4024" />
		<string key="name" value="40 Roland Street" />
		<string key="url" value="https://www.bostonplans.org/projects/development-projects/40-roland-street" />
		<boolean key="in_article_80" value="true" />
		<string key="neighborhood" value="Charlestown" />
		<string key="address" value="40 Roland Street" />
		<int key="land_sqft" value="186818" />
		<int key="gross_floor_area_sqft" value="753783" />
		<string key="description" value="The proposed 40 Roland Street Project is one of three projects that comprise the Proponent’s Sullivan Square masterplan vision. The Project will provide a robust, job-centric program mix in a gateway location. The residential component will include a significant number of affordable units to complement and diversify the Project's principal focus on facilitating emerging industries. In addition, a prominent open space along Cambridge Street will provide community green space. These elements will provide a catalyst for a lively, walkable realm that can be extended by future development further south into the Inner Belt and west into East Somerville. The Project will provide approximately 753,783 gross square feet of new lab/office, residential and retail development in three new buildings ranging in height from six to nine stories, along with 279 vehicle parking spaces." />
		<string key="phase" value="Board Approved" />
		<string key="project_type" value="Large Project" />
