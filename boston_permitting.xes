	<trace>
		<string key="concept:name" value="2512" />
		<int key="project_id" value="2512" />
		<string key="name" value="1954 Commonwealth Avenue" />
		<string key="url" value="https://www.bostonplans.org/projects/development-projects/1954-commonwealth-avenue" />
		<boolean key="in_article_80" value="true" />
		<string key="neighborhood" value="Brighton" />
		<string key="address" value="1954 Commonwealth Avenue" />
		<int key="land_sqft" value="13337" />
		<int key="gross_floor_area_sqft" value="23863" />
		<string key="description" value="Glenshane Properties (“the Proponent”) proposes to develop  a 26-unit multi-family residential development by relocating closer to Commonwealth Avenue and preserving the Site’s existing historic residence, relocating a reconstructed porte cochere, installing a new driveway, modifying the existing stone wall, re-landscaping, and constructing behind the house a new 6-story building with connected central lobby including one (1) level parking beneath the rear building. The Project will reconfigure the interiors of both the existing house and the rear building to align the unit mix with community demand and market realities, by increasing the units in the existing house from 3 to 6, increasing the 13 units currently permitted in the rear building to 20 units, and preserving the exterior dimensions of those structures. An elevator will serve all floors of the rear building, including the parking level. As well as all the unit entries in the Existing Building." />
		<string key="phase" value="Board Approved" />
		<string key="project_type" value="Small Project" />
