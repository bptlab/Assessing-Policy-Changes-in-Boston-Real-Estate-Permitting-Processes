es&lt;/td&gt;&lt;td&gt;&lt;img alt= 'Category: Transportation Improvements' title = 'Transportation Improvements' src='http://www.bostonplans.org/images/placeholders/ComBen_Icons/Transportation Improvements.png'&gt;&lt;/img&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr class='oblastTr'&gt;&lt;td&gt;&lt;span&gt;Amount:&lt;/span&gt;&lt;p&gt;Non-Monetary&lt;/td&gt;&lt;td&gt;&lt;span&gt;Description:&lt;/span&gt;&lt;p&gt;Transit-Oriented Development Features&lt;/p&gt;&lt;/td&gt;&lt;td class='obSeperator'&gt;&amp;nbsp&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" />
