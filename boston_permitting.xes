	<trace>
		<string key="concept:name" value="3766" />
		<int key="project_id" value="3766" />
		<string key="name" value="RLFMP - Parcel L-1" />
		<string key="url" value="https://www.bostonplans.org/projects/development-projects/24-drydock-avenue" />
		<boolean key="in_article_80" value="true" />
		<string key="neighborhood" value="South Boston Waterfront" />
		<string key="address" value="24 Drydock Avenue" />
		<int key="land_sqft" value="58875" />
		<int key="gross_floor_area_sqft" value="236375" />
		<string key="description" value='Cronin Drydock, LLC, an affiliate of Cronin Development (collectively, the "Proponent"), filed an Expanded Project Notification Form ("EPNF") with the BPDA on Friday, March 12th, 2021 for the Proposed Project at 24 Drydock Avenue in the Raymond L. Flynn Marine Park ("RLFMP") of the South Boston Waterfront. The Proponent proposes the demolition of the existing three (3)-story structure on the Project Site and the construction of a new, eight (8)-story, mixed-use building totaling approximately 236,375 square feet of marine industrial, life sciences/research and development, and supportive uses (the "Proposed Project"). The Proposed Project has been designed and proposed in keeping with the goals of the 2017 RLFMP Master Plan Update, which allows for the preservation of the RLFMP as a vital city-center industrial district while encouraging new economy uses. The Proposed Project contemplates the provision of space for two principal tenants, Boston Ship Repair and life sciences/research and development facilities.' />
		<string key="phase" value="Board Approved" />
		<string key="project_type" value="Large Project" />
