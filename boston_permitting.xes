	<trace>
		<string key="concept:name" value="4329" />
		<int key="project_id" value="4329" />
		<string key="name" value="500 Western Avenue" />
		<string key="url" value="https://www.bostonplans.org/projects/development-projects/500-western-avenue" />
		<boolean key="in_article_80" value="true" />
		<string key="neighborhood" value="Brighton" />
		<string key="address" value="500 Western Avenue" />
		<int key="land_sqft" value="33010" />
		<int key="gross_floor_area_sqft" value="96703" />
		<string key="description" value="The project would transform a vacant and non-conforming industrial site in north Brighton, with a new six (6) story building of approximately 99,000 gross square feet, including 116 residential apartments and artist live-work units, ground floor retail, below-grade parking for its residences and a “district parking” program to address the City’s planned reduction of on-street spaces along Western Avenue (the “Project”). It would also replace and upgrade inaccessible sidewalks, impervious surfaces and lacking open space, with improved connectivity, robust street tree canopies and new public realm. As a de facto density bonus, the Project also seeks to exceed the City’s Inclusionary Development Policy, by dedicating approximately eighteen percent (18%) of its total units for a wider range of income-restricted housing." />
		<string key="phase" value="Board Approved" />
		<string key="project_type" value="Large Project" />
