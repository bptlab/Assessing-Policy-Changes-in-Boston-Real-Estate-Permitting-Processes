	<trace>
		<string key="concept:name" value="2206" />
		<int key="project_id" value="2206" />
		<string key="name" value="64 Allandale Street" />
		<string key="url" value="https://www.bostonplans.org/projects/development-projects/64-allandale-street" />
		<boolean key="in_article_80" value="false" />
		<string key="neighborhood" value="West Roxbury" />
		<string key="address" value="64 Allandale Street" />
		<int key="land_sqft" value="87126" />
		<int key="gross_floor_area_sqft" value="35800" />
		<string key="description" value='On May 12, 2016, the BPDA Board voted its approval of the Proposed Project at 64 Allandale Street in West Roxbury (the "Original Project"). The Original Project called for the construction of sixteen (16) new townhouses, the creation of four (4) additional residential units in the existing home on the approximately two (2) acre Project Site, and approximately forty-seven (47) off-street parking spaces. &#10;&#10;A first Notice of Project Change (the "First NPC") was approved by the BPDA on November 17, 2016, reflecting a revised program of fourteen (14) new construction townhouses and four (4) residential units in the existing home. &#10;&#10;The Proponent, WonderGroup, LLC, filed a second Notice of Project Change (the "Second NPC") with the BPDA on April 8, 2021. The Proposed Project, as described in the Second NPC, now contemplates the construction of ten (10) new townhouses, four (4) units in the existing house, and a two (2) unit addition to the existing house. The proposed sixteen (16)-unit project at 64 Allandale Street now totals approximately 35,800 square feet of Gross Floor Area ("GFA") and includes twenty-eight (28) vehicular parking spaces.' />
		<string key="phase" value="Board Approved" />
		<string key="project_type" value="Small Project" />
