	<trace>
		<string key="concept:name" value="4305" />
		<int key="project_id" value="4305" />
		<string key="name" value="361 Centre Street (Blessed Sacrament)" />
		<string key="url" value="https://www.bostonplans.org/projects/development-projects/361-centre-street" />
		<boolean key="in_article_80" value="true" />
		<string key="neighborhood" value="Jamaica Plain" />
		<string key="address" value="361 Centre Street" />
		<int key="land_sqft" value="20701" />
		<int key="gross_floor_area_sqft" value="63148" />
		<string key="description" value="The proposed Project involves the renovation and adaptive reuse of the Blessed Sacrament Church, located at 361 Centre Street in Jamaica Plain, into a mixed-use, mixed-income housing development. Pennrose will honor the Blessed Sacrament’s architecture and history while adding to Hyde Square’s affordable housing stock. The Project has an estimated gross building area of 63,235 sf, which will be developed as a multipurpose/performance space (6,475 sf, to be operated by HSTF) and 55 residential units plus management, maintenance, and community spaces (56,764 sf, to be operated by Pennrose). These spaces will be housed in the existing structure, as well as two discrete and accessible residential additions at the rear of the building." />
		<string key="phase" value="Under Construction" />
		<string key="project_type" value="Large Project" />
