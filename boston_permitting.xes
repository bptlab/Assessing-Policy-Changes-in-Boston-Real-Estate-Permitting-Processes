		<string key="name" value="125 Amory Street Development" />
		<string key="url" value="https://www.bostonplans.org/projects/development-projects/125-amory-street-development" />
		<boolean key="in_article_80" value="true" />
		<string key="neighborhood" value="Jamaica Plain" />
		<string key="address" value="125 Amory Street" />
		<int key="land_sqft" value="58329" />
		<int key="gross_floor_area_sqft" value="461612" />
		<string key="description" value='The 125 Amory Street Development ("Proposed Project") includes the renovatoin of the existing Amory Street Apartments building which serves 199 low-income senior residents and persons with disabilities. Amory Street Partners ("Project Proponent") will renovate this property, and add up to 10 new affordable senior units in space currently used for the BHA Administrative Offices.  The Proposed Project also includes construction of approximately 262250 square feet across three new buildings on land adjacent to Amory Street Apartments, and will also contain approximately 305 units of new rental housing - approximately 196 of which will be restricted as affordable.  The buildings will be designed and constructed in accordance with Boston Green Building Regulations. The Proposed Project will also include approximately 208 parking spaces.' />
		<string key="phase" value="Under Construction" />
		<string key="project_type" value="Large Project" />
