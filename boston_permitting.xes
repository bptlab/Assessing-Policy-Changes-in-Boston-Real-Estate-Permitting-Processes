	<trace>
		<string key="concept:name" value="3868" />
		<int key="project_id" value="3868" />
		<string key="name" value="55-115 Hampden Street" />
		<string key="url" value="https://www.bostonplans.org/projects/development-projects/hampden-street-development-project" />
		<boolean key="in_article_80" value="true" />
		<string key="neighborhood" value="Roxbury" />
		<string key="address" value="55-115 Hampden Street" />
		<int key="land_sqft" value="142876" />
		<int key="gross_floor_area_sqft" value="89487" />
		<string key="description" value='F.W. Webb Company (the "Proponent") filed a Project Notification Form ("PNF") with the BPDA on Friday, August 13th, 2021 for the redevelopment of an approximately 3.28 acre site in the Roxbury Neighborhood District and the Newmarket Industrial Development Area sub-district (the "Project Site"). The Project Site consists of a series of parcels with addresses of 55 - 115 Hampden Street, 32 - 68 Yeoman Street (discontinued), and 22 - 58 Chadwick Street (discontinued). The Proponent intends to consolidate the parcels and subdivide the Project Site into two (2) lots: one (1) lot consisting of approximately 1.97 acres ("Lot 1") and the other consisting of approximately 1.31 acres ("Lot 2"). The Proposed Project contemplates the construction of an approximately 66,000 square foot F.W. Webb warehouse, distribution, and retail facility with approximately 25,000 square feet (approximately 86 spaces) of surface parking.' />
		<string key="phase" value="Construction Complete" />
		<string key="project_type" value="Large Project" />
