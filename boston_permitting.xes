	<trace>
		<string key="concept:name" value="1314" />
		<int key="project_id" value="1314" />
		<string key="name" value="Fenway Center - Parcel 7 Air Rights" />
		<string key="url" value="https://www.bostonplans.org/projects/development-projects/parcel-7-air-rights" />
		<boolean key="in_article_80" value="true" />
		<string key="neighborhood" value="Fenway" />
		<string key="address" value="75 Brookline Avenue" />
		<int key="land_sqft" value="196020" />
		<int key="gross_floor_area_sqft" value="1000000" />
		<string key="description" value="The Notice of Project Change and PDA Amendment outline several changes to the approved Phase 2 project. Key modifications of the Proposed Project include:&#10;- A shift in proposed uses of Buildings 3 and 4 from a mix of residential, office, and lab uses to a mix of office/R&amp;D/lab and life sciences uses in order to address current investor and market demand for such uses in proximity to the Longwood Medical Area (LMA), robust public transit, and Boston University,&#10;- A modest increase in the maximum height of Buildings 3 and 4 due primarily to the need for more expansive rooftop mechanicals and an increased floor-to-floor height necessary to accommodate office/R&amp;D/lab and life sciences uses,&#10;- A significant reduction of approximately 500 vehicle parking spaces on the Site,&#10;- An increase of approximately 3,669 square feet (“SF”) of additional civic open space accessible to the public than was proposed in the previously approved project, and&#10;- The provision of over a half-acre of outdoor, landscaped roof terrace space for Phase 2 building tenants that will provide a break in the massing of the overall development as well as an open-air link between the two buildings," />
		<string key="phase" value="Under Construction" />
		<string key="project_type" value="Large Project" />
