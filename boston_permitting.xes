	<trace>
		<string key="concept:name" value="5044" />
		<int key="project_id" value="5044" />
		<string key="name" value="780 American Legion Highway" />
		<string key="url" value="https://www.bostonplans.org/projects/development-projects/780-american-legion-highway-(1)" />
		<boolean key="in_article_80" value="true" />
		<string key="neighborhood" value="Roslindale" />
		<string key="address" value="780 American Legion Highway" />
		<int key="land_sqft" value="112410" />
		<int key="gross_floor_area_sqft" value="139889" />
		<string key="description" value='The Property consists of approximately 2.58 acres located within the Roslindale neighborhood of Boston. It is currently occupied by the Home for Little Wanderers and contains existing office and community service uses, associated surface parking, circulation areas, and landscaped open space. The Property is mapped within the Two-Family Residential ("2F-5000 ") Subdistrict of the Roslindale Neighborhood District, as well as the Greenbelt Protection Overlay District (GPOD). While the applicable dimensional requirements and required permits will be further detailed in the forthcoming Project Notification Form, it is anticipated at this time that variances will be required for Use, Floor Area Ratio (FAR), Building Height, Usable Open Space, and Minimum Parking.&#10;&#10;The Charles H. Farnsworth Housing Corporation is proposing the development of Farnsworth House II as a new, two-phase affordable senior housing community serving residents aged 62 and older. The current concept includes approximately 114 mixed-income affordable senior apartments across two buildings totaling approximately 140,000gsf. The unit mix is anticipated to consist primarily of one-bedroom apartments, with a limited number of two-bedroom units, including a manager’s unit.&#10;&#10;The proposed development is intended to expand the availability of high-quality, affordable senior housing in Roslindale while incorporating supportive services and resident amenities that promote aging in community. The project is anticipated to include resident common areas, transportation services, a large multi-purpose room for resident and community programming, and an adult day health center that may serve both residents and the surrounding community.' />
		<string key="phase" value="Letter of Intent" />
		<string key="project_type" value="Large Project" />
		<event>
			<string key="concept:name" value="Letter of Intent (LOI)" />
			<date key="time:timestamp" value="2026-07-17T00:00:00+00:00" />
			<string key="text" value="" />
			<string key="url" value="https://bpda.box.com/s/4q8lj331i99w46b1cyn85posx5kp9t8s" />
		</event>
	</trace>
