		<string key="neighborhood" value="Jamaica Plain" />
		<string key="address" value="920 Centre Street" />
		<int key="land_sqft" value="144943" />
		<int key="gross_floor_area_sqft" value="192000" />
		<string key="description" value="The Proposed Project consists of the demolition of the existing 50,000 SF monastery building and the construction of a new steel-framed building in its place that includes 79 condominium units and 79 apartment units, of which 38 will be designated as affordable.  The Project will also include over 7,000 SF of amenity spaces, 158 parking spaces, and 158 long-term bicycle parking spaces.  The Project also proposes significant site and public realm improvements that include reducing the amount of impervious surfaces, expanding the existing tree canopy, increasing the landscaping throughout the property, and encouraging multimodal transportation through the provision of a new blue-bike station and MBTA bus shelter." />
		<string key="phase" value="Under Review" />
		<string key="project_type" value="Large Project" />
