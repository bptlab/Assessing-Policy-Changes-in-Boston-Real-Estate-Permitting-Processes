	<trace>
		<string key="concept:name" value="3303" />
		<int key="project_id" value="3303" />
		<string key="name" value="Simmons University 2019 IMP Projects" />
		<string key="url" value="https://www.bostonplans.org/projects/development-projects/simmons-university-2019-imp-projects" />
		<boolean key="in_article_80" value="true" />
		<string key="neighborhood" value="Fenway" />
		<string key="address" value="300 Fenway Street" />
		<int key="land_sqft" value="100000" />
		<int key="gross_floor_area_sqft" value="498840" />
		<string key="description" value="In the past year, Simmons has transitioned to a University and reorganized its academic programming into four distinct colleges. The Proponent's updated Institutional Master Plan will enhance its academic facilities consistent with this new structure and create a consolidated academic and residential campus. The Proposed Projects include renovations to Lefavour Hall and the Main College Building to accommodate the University's Library as well as College of Natural, Behavioral, and Health Sciences (CNBHS), and the proposal calls for demolition of the existing Park Science Center for the construction of a new, 18-story Living and Learning Center, which will provide athletics space, a dining hall, and approximately 1,100 dormitory beds." />
		<string key="phase" value="Under Construction" />
		<string key="project_type" value="Large Project" />
