	<trace>
		<string key="concept:name" value="3336" />
		<int key="project_id" value="3336" />
		<string key="name" value="69 Bailey Street" />
		<string key="url" value="https://www.bostonplans.org/projects/development-projects/69-bailey-street" />
		<boolean key="in_article_80" value="true" />
		<string key="neighborhood" value="Dorchester" />
		<string key="address" value="69 Bailey Street" />
		<int key="land_sqft" value="18284" />
		<int key="gross_floor_area_sqft" value="16342" />
		<string key="description" value="The Proposed Project will include 19 Compact Living Units, which includes 2 studios, 2 two-bedroom units, and 17 one-bedroom units, and which Compact Living Units comply with the Compact Living Policy’s Unit Interior Guidelines in regard to function, storage and daylight. The Proposed Project includes approximately 1,557 square feet of shared space, which is in compliance with the Shared Spaces Size Requirements for Proposed Project containing 15-29 units under the Compact Living Policy. The Shared Spaces include a shared meeting room as well as a rear lawn recreation area which are located both inside and outside the Proposed Project and provide a physical setting for common use and also incorporate programming and design that encourages residents to connect in compliance with the Compact Living Policy. The Proposed Project includes 8 parking spaces, which is in compliance with the maximum parking per unit guidelines and results in 11 Transportation Demand Management (“TDM”) points. The Developer shall fulfill their TDM points through a 50% transit subsidy in perpetuity for building residents, 2 on-site car share parking spaces, and a bicycle repair station." />
		<string key="phase" value="Construction Complete" />
		<string key="project_type" value="Small Project" />
