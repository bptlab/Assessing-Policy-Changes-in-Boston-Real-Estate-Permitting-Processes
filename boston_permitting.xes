		<boolean key="in_article_80" value="true" />
		<string key="neighborhood" value="Dorchester" />
		<string key="address" value="25 Tolman Street" />
		<int key="land_sqft" value="22670" />
		<int key="gross_floor_area_sqft" value="23220" />
		<string key="description" value="25 Tolman street utilizes the footprint and height-profile of the existing structure and an ample 22,670 square foot lot to construct seventeen (17) total home-ownership units, each with its own parking space.  The units are a combination of townhouses and apartment-style units, and are spread out within three different structures, with six (6) units in the Tolman Street apartment building, and the remaining eleven (11) townhouses in the rear portion of the lot.  In addition, a second driveway will be constructed off Morrissey Boulevard so as not to burden Tolman Street.  The density of the lot is below a Floor Area Ratio of 1.0, intended to reflect the massing of nearby structures." />
		<string key="phase" value="Under Review" />
		<string key="project_type" value="Small Project" />
