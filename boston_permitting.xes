			<string key="text" value="&lt;span class='sm-obligations'&gt;Community Benefits&lt;/span&gt;&lt;table class='obligationTable' &gt;&lt;tr class='obFirstTr'&gt;&lt;td class='obName'&gt;Annual music scholarships for Boston residents&lt;/td&gt;&lt;td&gt;&lt;img alt= 'Category: Institutional Proponent Decision' title = 'Institutional Proponent Decision' src='http://www.bostonplans.org/images/placeholders/ComBen_Icons/Institutional Proponent Decision.png'&gt;&lt;/img&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr class='oblastTr'&gt;&lt;td&gt;&lt;span&gt;Amount:&lt;/span&gt;&lt;p&gt;$15,000,000.00&lt;/td&gt;&lt;td&gt;&lt;span&gt;Description:&lt;/span&gt;&lt;p&gt;Annual music scholarships for Boston residents&lt;/p&gt;&lt;/td&gt;&lt;td class='obSeperator'&gt;&amp;nbsp&lt;/td&gt;&lt;/tr&gt;&lt;tr class='obFirstTr'&gt;&lt;td class='obName'&gt;Education and community outreach programs&lt;/td&gt;&lt;td&gt;&lt;img alt= 'Category: Community Based Organizations' title = 'Community Based Organizations' src='http://www.bostonplans.org/images/placeholders/ComBen_Icons/Community Based Organizations.png'&gt;&lt;/img&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr class='oblastTr'&gt;&lt;td&gt;&lt;span&gt;Amount:&lt;/span&gt;&lt;p&gt;$5,000,000.00&lt;/td&gt;&lt;td&gt;&lt;span&gt;Description:&lt;/span&gt;&lt;p&gt;Education and community outreach programs&lt;/p&gt;&lt;/td&gt;&lt;td class='obSeperator'&gt;&amp;nbsp&lt;/td&gt;&lt;/tr&gt;&lt;tr class='obFirstTr'&gt;&lt;td class='obName'&gt;New street trees and street furniture&lt;/td&gt;&lt;td&gt;&lt;img alt= 'Category: Parks' title = 'Parks' src='http://www.bostonplans.org/images/placeholders/ComBen_Icons/Parks.png'&gt;&lt;/img&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr class='oblastTr'&gt;&lt;td&gt;&lt;span&gt;Amount:&lt;/span&gt;&lt;p&gt;Non-Monetary&lt;/td&gt;&lt;td&gt;&lt;span&gt;Description:&lt;/span&gt;&lt;p&gt;New street trees and street furniture&lt;/p&gt;&lt;/td&gt;&lt;td class='obSeperator'&gt;&amp;nbsp&lt;/td&gt;&lt;/tr&gt;&lt;tr class='obFirstTr'&gt;&lt;td class='ob