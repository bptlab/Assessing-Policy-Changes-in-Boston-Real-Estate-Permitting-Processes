		<boolean key="in_article_80" value="true" />
		<string key="neighborhood" value="Fenway" />
		<string key="address" value="1400 Boylston Street" />
		<int key="land_sqft" value="104440" />
		<int key="gross_floor_area_sqft" value="553000" />
		<string key="description" value="Samuels &amp; Associates Development LLC (the &quot;Proponent&quot;) has proposed redevelopment of the approximately 2.4-acre site at 1380-1420 Boylston Street in the Fenway, which is presently occupied by a single-story Star Market grocery store, a decommissioned gas station, and surface parking lots. The Proposed Project would revitalize the site with the construction of an approximately 553,000 gross square foot project, including approximately 498,000 square feet of office/research and development space, approximately 17,000 square feet of retail/restaurant/service and accessory uses and facilities on the ground floor, approximately 33,000 square feet of enclosed loading and back of house space, approximately 5,000 square foot civic building which will be programmed in response to community needs and could serve as a Boston Public Library neighborhood branch, and over half an acre of landscaped green space, with underground parking to support the building's programming." />
		<string key="phase" value="Board Approved" />
		<string key="project_type" value="Large Project" />
