	<trace>
		<string key="concept:name" value="3689" />
		<int key="project_id" value="3689" />
		<string key="name" value="180 Western Avenue" />
		<string key="url" value="https://www.bostonplans.org/projects/development-projects/180-western-avenue" />
		<boolean key="in_article_80" value="true" />
		<string key="neighborhood" value="Allston" />
		<string key="address" value="180 Western Avenue" />
		<int key="land_sqft" value="50277" />
		<int key="gross_floor_area_sqft" value="162000" />
		<string key="description" value="The Proponent proposes to demolish the existing buildings on the Project Site and to construct a pedestrian-oriented, mixed-use building containing approximately 200,000 square feet of GFA, including residential space (up to 280 units), ground-floor retail, restaurant, services, and accessory spaces, shared amenity space, and approximately 10,000 square feet of outdoor amenity spaces located on various roof terraces, served by an at-grade structured parking garage. The retail component of the Project will be located along Western Avenue and North Harvard Street, wrapping around the structured parking. The Project will also include enclosed secure bike storage areas for residents and employees of the Project, as well as publicly accessible short-term bicycle parking spaces and new on-street parking spaces. The Project will also create approximately 11,000 square feet of new sidewalk area and an active café zone along the Project Site frontage, along with new landscaping and hardscaped public spaces, and additional amenities." />
		<string key="phase" value="Board Approved" />
		<string key="project_type" value="Large Project" />
