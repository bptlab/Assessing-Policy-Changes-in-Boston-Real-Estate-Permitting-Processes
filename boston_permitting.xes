		<string key="neighborhood" value="Dorchester" />
		<string key="address" value="1205 Dorchester Avenue" />
		<int key="land_sqft" value="171657" />
		<int key="gross_floor_area_sqft" value="385531" />
		<string key="description" value='On May 12th, 2016, the BPDA Board approved an approximately 388,400 gross square foot mixed-use Dot Block development project, including the construction of approximately 362 residential units, a five (5)-story above-grade parking garage, and approximately 37,000 gross square feet of retail (the "Originally Approved Project").&#10;&#10;On January 31st, 2019, Wintergold, LLC, in collaboration with Samuels &amp; Associates, filed a Notice of Project Change with the Boston Planning &amp; Development Agency for the Dot Block project, which, as proposed, is planned to comprise approximately 488 residential units (approximately 7 of which are expected to be artist live/work units, and 66 of which will be affordable housing units with a range of income eligibility) in four new buildings, approximately 23,000 square feet of neighborhood-oriented retail and restaurant space, approximately 1.34 acres of open space, a below-grade parking garage, and related landscape and streetscape improvements (the "Proposed Project").' />
		<string key="phase" value="Under Construction" />
		<string key="project_type" value="Large Project" />
