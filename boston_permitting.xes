	<trace>
		<string key="concept:name" value="4252" />
		<int key="project_id" value="4252" />
		<string key="name" value="Belvidere Street Student Housing" />
		<string key="url" value="https://www.bostonplans.org/projects/development-projects/belvidere-street-student-housing" />
		<boolean key="in_article_80" value="true" />
		<string key="neighborhood" value="Back Bay" />
		<string key="address" value="39 Dalton Street" />
		<int key="land_sqft" value="0" />
		<int key="gross_floor_area_sqft" value="250000" />
		<string key="description" value="To support local student housing needs, the Proponent is seeking to convert approximately 428 sleeping rooms within the existing approximately 250,000-square foot South Tower of the Sheraton Boston Hotel located at 39 Dalton Street in the Back Bay neighborhood into a dormitory,  housing approximately 856 students. &#10;The Proposed Project also includes repurposing the existing hotel ground floor retail area (approximately 6,000-square foot hair/nail salon accessible to both hotel guests and non-guests) and third-floor hotel area to create approximately 18,000 square feet of dedicated student amenities, including uses such as a student lounge, café/dining, quiet study area, laundry room, and/or fitness center. The Proposed Project also includes a new main building entry dedicated to students, including maintaining the existing publicly-accessible outdoor plaza as-is with cosmetic upgrades, such as new seating, lighting, and/or signage." />
		<string key="phase" value="Under Construction" />
		<string key="project_type" value="Large Project" />
