	<trace>
		<string key="concept:name" value="4465" />
		<int key="project_id" value="4465" />
		<string key="name" value="617 Dorchester Avenue f/k/a 20 Boston Street" />
		<string key="url" value="https://www.bostonplans.org/projects/development-projects/617-dorchester-avenue-20-boston-street" />
		<boolean key="in_article_80" value="false" />
		<string key="neighborhood" value="South Boston" />
		<string key="address" value="617 Dorchester Avenue" />
		<int key="land_sqft" value="6135" />
		<int key="gross_floor_area_sqft" value="18407" />
		<string key="description" value="The proposed project consists of a new four-story residential building situated on a through lot&#10;fronting both Dorchester Avenue and Boston Street. The project is located on a vacant 6,135&#10;square foot parcel and proposes the construction of eighteen residential condominium units,&#10;with a residential lobby, bike parking room, trash area, community room, and a spacious common&#10;roof deck. The main entrance is provided at-grade and accessed on Dorchester Avenue. The&#10;building also includes an accessible basement, providing private storage rooms for each unit.&#10;There are accessible paths that run parallel along the entire site, allowing for passage to either&#10;Dorchester Avenue or Boston Street, installed with privacy gates to ensure the security and&#10;privacy of the residents. Residential units are located on every level, although units on the first&#10;floor have been raised above the SLR-BFE. Owing to proximity to the MBTA’s Andrew Station on&#10;the Red Line, no on-site motor vehicle parking is proposed." />
		<string key="phase" value="Under Review" />
		<string key="project_type" value="Small Project" />
