		<int key="land_sqft" value="29480" />
		<int key="gross_floor_area_sqft" value="61107" />
		<string key="description" value="The Project will be developed on an approximately 0.7-acre site at the edge of Union Square on North Beacon Street in Allston (the “Project Site”). The Proposed Project consist of approximately 82,387 gross square foot new five-story building at the corner of North Beacon Street and Everett Street containing seventy-two (72) rental apartments (“Rental Building”) as well as a separate approximately four-story building on Sinclair Road consisting of nine (9) for sale condominiums (“Condo Building”) with off-street parking for 43 vehicles. The Project will capitalize on its urban setting by providing a series of amenities to encourage the use of alternative methods of transportation, including, covered and secure bike storage for each unit, a transit screen in the lobby providing schedules for local transit options, and on site ride sharing service." />
		<string key="phase" value="Construction Complete" />
		<string key="project_type" value="Large Project" />
